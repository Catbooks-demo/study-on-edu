# 스터디온에듀 설정 예시. 복사해서 .env 로 쓰고, .env 는 커밋하지 않는다.

# PostgreSQL 접속 주소
DATABASE_URL=postgresql://studyon:change-me@localhost:5432/studyon
# compose 가 DB를 만들 때 쓰는 비밀번호 (DATABASE_URL 의 비밀번호와 같게)
POSTGRES_PASSWORD=change-me

# 세션·쿠키 서명용 비밀값 (운영에서는 32자 이상이어야 켜짐): openssl rand -base64 32
SESSION_SECRET=
# 사이트 바깥 주소 (https 면 쿠키에 Secure 가 붙는다)
APP_BASE_URL=http://localhost:3000
# compose 에서 앱이 열 포트 (127.0.0.1 에만)
APP_PORT=3200

# 토스페이먼츠 테스트 키 (test_ 로 시작). 비우면 모의 결제. live_ 키는 시작을 거부한다.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# 시드가 만들 첫 직원(관리자) 계정. 비우면 직원 계정을 만들지 않는다.
SEED_STAFF_EMAIL=
SEED_STAFF_PASSWORD=
# 시드가 만들 가상 강사 계정 비밀번호. 비우면 강사 계정을 만들지 않는다.
SEED_INSTRUCTOR_PASSWORD=

# 주기 작업(결제 전 주문 만료·구독 갱신·정산 등)을 이 앱에서 돌릴지
JOBS_ENABLED=true

# 시연용 장애 주입을 켤 수 있게 할지. 시연 서버에서만 true.
FAULTS_ENABLED=false

# 플레이어 하트비트 주기(초)
NEXT_PUBLIC_HEARTBEAT_SEC=30
